FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 51212
CMD ["sh", "-c", "rm -f /tmp/starter-db-ready && npm run prisma:generate && npm run prisma:push && npm run prisma:seed && touch /tmp/starter-db-ready && npm run prisma:studio"]
