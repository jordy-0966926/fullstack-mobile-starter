{
  "name": "db",
  "type": "module",
  "exports": {
    "./schema": "./prisma/drizzle/schema.ts",
    "./client": "./lib/prisma.ts",
    "./drizzle": "./lib/drizzle.ts"
  },
  "scripts": {
    "dev": "tsx ./src/index.ts --watch",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:studio": "prisma studio --browser none --port 51212",
    "prisma:push": "prisma db push",
    "prisma:seed": "prisma db seed"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "dotenv": "^17.2.3",
    "drizzle-prisma-generator": "^0.1.7",
    "prisma": "^7.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.0.1",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.16.3"
  },
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
